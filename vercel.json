{
  "buildCommand": "",
  "outputDirectory": "landing",
  "framework": null,
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/vi", "destination": "/vi/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
